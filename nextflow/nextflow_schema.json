{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/broadinstitute/gatk-sv/main/nextflow/nextflow_schema.json",
    "title": "gatk-sv-nextflow pipeline parameters",
    "description": "Nextflow reimplementation of the GATK-SV harmonisation pipeline. See nextflow/README.md.",
    "type": "object",
    "properties": {
        "input": {
            "type": "string",
            "format": "file-path",
            "exists": true,
            "pattern": "^\\S+\\.tsv$",
            "description": "Sample sheet TSV (family_id, sample_id, bam, bai). See README.md#sample-sheet.",
            "schema": "assets/schema_samplesheet.json"
        },
        "fasta": {
            "type": "string",
            "format": "file-path",
            "exists": true,
            "description": "Reference genome FASTA (hg38)."
        },
        "fasta_fai": {
            "type": "string",
            "format": "file-path",
            "exists": true,
            "description": "Reference genome FASTA index (.fai)."
        },
        "outdir": {
            "type": "string",
            "format": "directory-path",
            "description": "Output directory for published results.",
            "default": "./results"
        }
    },
    "required": ["input", "fasta", "fasta_fai"]
}
