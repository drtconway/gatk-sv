// Site-specific Slurm/Apptainer config -- NOT loaded automatically.
//
// Copy this file to conf/hpc.config (gitignored, see nextflow/README.md)
// and fill in real values for your cluster. `-profile apptainer` (defined
// in ../nextflow.config) already enables the apptainer engine -- it's
// portable and stays committed. This file adds only what's specific to
// *this* cluster on top of it: queue names, account, bind paths. Run with
// both layered together, e.g.:
//
//   nextflow run workflows/call_manta.nf -profile apptainer \
//     -c conf/hpc.config --input samplesheet.tsv
//
// (--fasta/--fasta_fai aren't on the command line above because this file
// sets them under params {} below -- see the note there.)
//
// Keep queue names, account strings, and bind paths out of the committed
// nextflow.config -- that file should stay portable across every
// environment (local stub runs, someone else's cluster, this one). This
// file is where cluster-specific values belong instead.

process {
    executor = 'slurm'

    // TODO: your partition/queue name(s). A single default here is fine to
    // start with; add withLabel: overrides below once some processes need
    // a different partition (e.g. a high-memory queue for gCNV).
    queue = 'general'

    // TODO: Slurm account/project string, if your site requires one.
    // Leave as '' if not needed.
    clusterOptions = '--account=YOUR_ACCOUNT'

    // Recommended on shared/NFS filesystems: avoids false cache misses
    // from clock/timestamp differences between the submitting node and
    // compute nodes.
    cache = 'lenient'

    // Example per-label override -- add these as specific processes need
    // more memory/time than the process_medium default in nextflow.config,
    // or need a different partition (e.g. a himem queue):
    // withLabel: process_high {
    //     queue = 'himem'
    // }
}

// Tune Slurm job submission/polling behaviour. Defaults are conservative;
// raise queueSize once you've confirmed the scheduler and filesystem cope
// with more concurrent jobs.
executor {
    name            = 'slurm'
    queueSize       = 50
    submitRateLimit = '10 sec'
}

apptainer {
    // TODO: bind paths for any storage not under your home/project
    // directory that job scripts need to read/write, e.g.:
    // runOptions = '--bind /scratch --bind /data'
}

params {
    // TODO: resource ceilings for this cluster, if your partitions cap
    // below Nextflow's defaults.
    // max_memory = 256.GB
    // max_cpus   = 64
    // max_time   = '48.h'

    // Reference genome (hg38). These are pipeline-level params (declared
    // in ../nextflow.config, consumed by every caller/evidence-collection
    // workflow, not specific to Manta or any other single tool) but the
    // actual file paths are site-specific, so they belong here rather than
    // being retyped on the command line every run. A value set here
    // overrides the `null` default in nextflow.config; --fasta on the
    // command line would still override this, for a one-off run against a
    // different reference.
    fasta     = '/path/to/reference/hg38.fa'
    fasta_fai = '/path/to/reference/hg38.fa.fai'
}
