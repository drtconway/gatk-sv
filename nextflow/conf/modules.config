// Per-module publishDir/args overrides, keyed by process name (nf-core convention).

process {
    // Not published -- SVTK_STANDARDIZE's output (below) is the one
    // downstream harmonisation should consume: correct sample column
    // (ped_id), primary contigs only, ALGORITHMS set. This process's own
    // output has the BAM's SM tag and may include ALT-contig records.

    withName: 'WHAMG' {
        // GATK-SV's Wham task restricts calling to primary_contigs_list
        // via `-c` (wdl/Whamg.wdl:153). params.primary_contigs_list is a
        // static, sample-independent resource (one fixed file, not a
        // per-sample channel input), so its contents are read once here at
        // config-evaluation time rather than threaded through as a process
        // input.
        //
        // Must use the fully-qualified nextflow.Nextflow.file(), not the
        // bare file() factory function: ext.args closures run in a context
        // where `file` resolves to nextflow.script.ScriptBinding.file() (a
        // zero-arg accessor) instead, so a bare file(path) call fails with
        // "No signature of method: ...file() is applicable for argument
        // types: () values: []" -- a namespace collision specific to
        // config-closure scope, not present in ordinary workflow script
        // code. (A lib/*.groovy helper was tried first but classes there
        // aren't visible from conf/-included config closures in this
        // Nextflow version -- "No such variable" -- so the logic is
        // inlined here instead.)
        ext.args = {
            def contigs = params.primary_contigs_list
                ? nextflow.Nextflow.file(params.primary_contigs_list).readLines().findAll { it }.join(',')
                : ''
            contigs ? "-c ${contigs}" : ''
        }

        // whamg builds an in-memory index of discordant reads across the
        // whole genome ("Loading discordant reads into forest" in its own
        // log) -- real, memory-hungry work, not proportional to input
        // file size the way most tasks are. process_medium's 12GB (the
        // shared default for many lighter processes) OOM-killed a real
        // ~50x-coverage WGS sample partway through
        // (slurmstepd: oom_kill event, ~1800Mb of ~3.1Gb genome
        // processed). GATK-SV's own WDL sizing formula
        // (wdl/Whamg.wdl:101-110) defaults to a flat ~5GB without
        // Picard-metrics inputs (pf_reads_improper_pairs/pct_exc_total)
        // we don't currently wire up -- lower than what already failed,
        // so not a formula worth chasing here. Bumped to a flat, generous
        // value instead; revisit with real per-sample memory usage data
        // once more samples have run, rather than reverse-engineering
        // GATK-SV's metrics-dependent formula preemptively.
        //
        // 32GB wasn't enough for a later real sample either -- OOM-killed
        // (exit 137) past "Finished loading reads", during "Gathering
        // graphs from forest" (a later phase than the read-loading step
        // the original 32GB was sized against). That sample's own log
        // showed heavy breakpoint activity on decoy contigs
        // (chrUn_JTFH01...) and HLA alt-haplotype contigs -- -c only
        // restricts *calling* to primary_contigs_list
        // (wdl/Whamg.wdl:153), not what whamg loads/indexes beforehand,
        // so a sample with more decoy/alt-contig-mapped reads than usual
        // needs more memory than -c's own restriction would suggest.
        // Doubled to 64GB rather than a marginal bump, for real headroom
        // against the next similarly messy sample -- revisit again with
        // real per-sample peak usage if this OOMs a third time.
        //
        // Superseded by an escalating retry instead of chasing the flat
        // value upward again each time a messier sample OOMs:
        // task.attempt doubles memory on each retry from a lower base
        // (16/32/64/128GB across 4 total attempts, via 2**(attempt-1) --
        // Groovy's `<<` bit-shift also works for this but the power form
        // reads more directly as "double per attempt"), rather than the
        // flat-64GB-then-linear-scaling this pipeline tried first: a
        // lower starting point means a sample that only ever needed the
        // original 32GB doesn't pay for 64GB on its very first attempt,
        // while still reaching well past 64GB (128GB) if a retry is
        // needed at all. Same time scaling. Only retries on the specific
        // exit codes that mean "ran out of resources" (see
        // nextflow.config's own withLabel: error_retry note on why
        // 137/140 specifically, and why WHAMG can't just share that
        // label -- it's a vendored nf-core module kept unmodified by
        // convention).
        memory = { 16.GB * (2 ** (task.attempt - 1)) }
        cpus   = 6
        time   = { 8.h * (2 ** (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries = 3

        // Same "not published" reasoning as above -- see the note at the
        // top of this file.
    }

    withName: 'MANTA_GERMLINE' {
        // A real HPC run had Manta's own generateCandidateSV step
        // genuinely stall on one sample -- 17+ hours with zero progress
        // logged, eventually killed at process_medium's 8h time limit
        // (exit 140, 128+12/SIGUSR2). Traced to that one sample's own
        // BAM, not a pipeline/config issue -- dropping and re-running the
        // sample fixed it that time. This escalating time override is a
        // safety net for the next occurrence: modules/nf-core/manta/
        // germline/main.nf already declares `label 'error_retry'`
        // (nextflow.config's own withLabel: error_retry block gives that
        // label real retry mechanics -- errorStrategy/maxRetries, matched
        // to exit 137/140 specifically), this just adds the
        // escalating-time half a real timeout needs on top of that.
        // Doubles per attempt (8/16/32/64h across 4 total attempts),
        // matching WHAMG's own doubling scheme above rather than linear
        // scaling.
        //
        // If a sample is *genuinely* stuck (not just slow), 4 escalating
        // attempts will still exhaust and fail clearly with the same
        // stall signature -- worth checking the BAM itself at that point
        // (see the note above: this exact failure was a real, isolated
        // per-sample data issue, not something more time reliably fixes).
        time = { 8.h * (2 ** (task.attempt - 1)) }
    }

    withName: 'MEDIAN_COVERAGE' {
        memory = 64.GB
    }

    withName: 'GATK_COLLECT_READ_COUNTS' {
        // OOM'd for real at the shared process_single fallback (module's
        // own hardcoded 3GB default, used when task.memory is unset --
        // see modules/local/gatk4/collect_read_counts/main.nf): a real
        // ~50x WGS BAM completed a 91-minute whole-genome traversal
        // (729M reads) and then hit `java.lang.OutOfMemoryError: Java
        // heap space` in CollectReadCounts.onTraversalSuccess, building
        // the final binned-count list in memory before writing output --
        // genuinely proportional to genome-wide interval count, not a
        // per-chunk cost. Our 3GB default turned out to be a
        // mis-transcription of GATK-SV's own CollectCounts task
        // (wdl/CollectCoverage.wdl): its RuntimeAttr default_attr sets
        // mem_gb: 3.0, but that field is never actually used for the
        // memory calculation -- `Float machine_mem_gb = select_first([mem_gb,
        // 12.0])` (a separate top-level input, defaulting to 12.0)
        // is what actually sizes the JVM heap. Set to GATK-SV's real
        // effective default (12GB) here, not an arbitrary guess -- unlike
        // WHAMG's fixed override above, this is their own validated
        // value, not a number picked from one observed failure point.
        memory = 12.GB
    }

    withName: 'GATK_COLLECT_SV_EVIDENCE' {
        memory = 8.GB
    }

    withName: 'GATK_PRINT_SV_EVIDENCE' {
        // OOM'd for real (java.lang.OutOfMemoryError: Java heap space) at
        // the module's own hardcoded 3GB fallback (used when task.memory
        // is unset -- see modules/local/gatk4/print_sv_evidence/main.nf's
        // avail_mem logic, same pattern as GATK_COLLECT_READ_COUNTS
        // above), on the cohort-wide PE merge (vcfs_merge_evidence's
        // GATK_PRINT_SV_EVIDENCE_PE call site -- not the per-contig
        // GATK_PRINT_SV_EVIDENCE_CONTIG_* modules below, which already
        // have their own config entries and are unaffected). Died in
        // FeatureManager/MultiFeatureWalker startup, building a
        // TabixReader index for the ~180th of this run's per-sample
        // .pe.txt.gz inputs -- PrintSVEvidence opens every -F input file's
        // tabix index up front before merging, so the real memory cost is
        // proportional to *cohort size* (number of samples merged in one
        // call), not any single sample's evidence file size the way
        // WHAMG/MEDIAN_COVERAGE's costs are.
        //
        // That means this will OOM again, at a lower flat memory value,
        // as more samples are added to a growing panel (see CLAUDE.md's
        // own framing: cohorts here are expected to grow incrementally
        // over time, not stay fixed at whatever size first ran). Sized
        // with real headroom above the observed ~180-sample failure point
        // rather than a marginal bump, on the same reasoning as WHAMG's
        // flat-then-escalating history above -- revisit with real
        // per-run memory usage data (ideally scaled by sample count) if
        // this OOMs again at a larger cohort size.
        //
        // Deliberately NOT wired into the error_retry label/escalating
        // pattern used for WHAMG/MANTA_GERMLINE: those retry on Slurm-level
        // SIGKILL/timeout exit codes (137/140), but a JVM heap
        // OutOfMemoryError is the JVM itself exiting on an uncaught
        // exception (plain exit 1, not a signal) -- task.exitStatus here
        // wouldn't match 137/140 at all, so error_retry's condition would
        // never fire and this would just terminate immediately on the
        // first attempt regardless, same as it did before this fix.
        memory = 32.GB
    }

    withName: 'GATK_SITE_DEPTH_TO_BAF' {
        // Same failure, same root cause, same fix as GATK_PRINT_SV_EVIDENCE
        // immediately above: SiteDepthtoBAF is MultiFeatureWalker-based
        // too (modules/local/gatk4/site_depth_to_baf), so it OOM'd for
        // real the same way -- module's own hardcoded 3GB fallback,
        // FeatureManager building tabix indexes for every sample's
        // .sd.txt.gz up front, cost proportional to cohort size rather
        // than any one sample's file size. Hit on the very next real HPC
        // run after GATK_PRINT_SV_EVIDENCE's own fix went in -- this
        // module just hadn't been reached yet the first time, not a
        // fix that didn't work. Same 32GB value and same reasoning for
        // not using error_retry (plain JVM OutOfMemoryError, exit 1, not
        // 137/140) apply unchanged.
        memory = 32.GB
    }

    withName: 'SVTK_STANDARDIZE' {
        // This process runs once per caller per sample (called from both
        // bam_call_manta and bam_call_wham), so Manta's and Wham's output
        // for the same sample land in the same directory here -- doesn't
        // collide because the module itself includes `source` in the
        // output filename (*.<source>.std.vcf.gz), not just sample_id.
        publishDir = [
            path: { "${params.outdir}/standardized/${meta.id}" },
            mode: 'copy'
        ]
    }

    // GATK4_SVCLUSTER's own output is not published -- it's GATK-format,
    // pre-interval-exclusion, and gets refined further by
    // EXCLUDE_VARIANTS_BY_ID_POST + FORMAT_GATK_VCF_FOR_SVTK below.
    // Same pattern as WHAMG/SVTK_STANDARDIZE above: only the final,
    // fully-processed output is published.

    withName: 'FORMAT_GATK_VCF_FOR_SVTK' {
        // Used by both vcfs_cluster_svcluster (meta.id = caller name,
        // e.g. "manta") and vcfs_combine_batches (meta.id = cohort_name)
        // -- doesn't collide since those are different meta.id values.
        publishDir = [
            path: { "${params.outdir}/cluster/${meta.id}" },
            mode: 'copy'
        ]
    }

    withName: 'PLOIDY_TABLE_FROM_PED_COMBINE_BATCHES' {
        // GATK-SV's CombineBatches builds its own ploidy table with
        // retain_female_chr_y=true (wdl/CombineBatches.wdl:112),
        // different from vcfs_cluster_svcluster's own
        // PLOIDY_TABLE_FROM_PED call (stage 1, left at the default
        // false) -- see modules/local/ploidy_table_from_ped for what the
        // flag does.
        ext.retain_female_chr_y = true
    }

    // GATK4_SVCLUSTER_JOIN, GATK4_SVCLUSTER_SITES,
    // GATK4_GROUPEDSVCLUSTER_PART1/2's own intermediate output is not
    // published -- same "only the final output matters" reasoning as
    // elsewhere in this file. Only FORMAT_GATK_VCF_FOR_SVTK's output
    // (above) is the finished, cross-caller merged site list.

    withName: 'GATK4_SVCLUSTER_JOIN' {
        // Naive join across callers (wdl/CombineBatches.wdl's JoinVcfs):
        // near-zero overlap thresholds, only merges exact-position
        // duplicates -- real clustering happens in the next step
        // (GATK4_SVCLUSTER_SITES).
        ext.args = [
            '--fast-mode false',
            '--pesr-sample-overlap 0', '--pesr-interval-overlap 1', '--pesr-breakend-window 0',
            '--depth-sample-overlap 0', '--depth-interval-overlap 1', '--depth-breakend-window 0',
            '--mixed-sample-overlap 0', '--mixed-interval-overlap 1', '--mixed-breakend-window 0'
        ].join(' ')
    }

    withName: 'GATK4_SVCLUSTER_SITES' {
        // Real clustering pass (wdl/CombineBatches.wdl's ClusterSites):
        // realistic overlap thresholds, plus a variant-ID prefix keyed by
        // cohort_name (meta.id at this call site -- see
        // vcfs_combine_batches/main.nf's cluster_input construction).
        ext.args = { [
            '--fast-mode false', '--breakpoint-summary-strategy REPRESENTATIVE',
            "--variant-prefix ${meta.id}_",
            '--pesr-sample-overlap 0.5', '--pesr-interval-overlap 0.1', '--pesr-breakend-window 300',
            '--depth-sample-overlap 0.5', '--depth-interval-overlap 0.5', '--depth-breakend-window 500000',
            '--mixed-sample-overlap 0.5', '--mixed-interval-overlap 0.5', '--mixed-breakend-window 1000000'
        ].join(' ') }
    }

    withName: 'GATK4_GROUPEDSVCLUSTER_PART1' {
        ext.args = '--breakpoint-summary-strategy REPRESENTATIVE'
    }

    withName: 'GATK4_GROUPEDSVCLUSTER_PART2' {
        ext.args = '--breakpoint-summary-strategy REPRESENTATIVE'
    }

    // vcfs_generate_batch_metrics's two CONCAT_VCFS call sites, matching
    // wdl/GenerateBatchMetrics.wdl's own ConcatInputVcfs (allow_overlaps,
    // since different callers' VCFs aren't guaranteed non-overlapping)
    // and ConcatOutputVcfs (naive, since AggregateDepthEvidence's
    // per-shard output shards are already coordinate-sorted and
    // non-overlapping by construction -- ScatterVcf never splits a
    // contig's records across a shard boundary out of order).
    withName: 'CONCAT_INPUT_VCFS' {
        ext.args = '--allow-overlaps'
    }

    withName: 'CONCAT_OUTPUT_VCFS' {
        ext.args = '--naive'
    }

    // filter_batch_sites' own cross-caller merge, matching
    // wdl/GATKSVPipelineBatch.wdl's own MergePesrDepthVcfs call
    // (allow_overlaps=true).
    withName: 'MERGE_PESR_DEPTH_VCFS' {
        ext.args = '--allow-overlaps'
    }

    // genotype_batch's own shard-concat: GATK_GENOTYPESVS's per-contig
    // output shards are coordinate-sorted and non-overlapping by
    // construction (one contig per shard, via -L), same reasoning as
    // CONCAT_OUTPUT_VCFS above.
    withName: 'CONCAT_GENOTYPE_BATCH_SHARDS' {
        ext.args = '--naive'
    }

    // genotype_batch's three per-contig PrintSVEvidence calls -- GATK's
    // own codec detection is filename-suffix-based
    // (".rd.txt.gz"/".pe.txt.gz"/".sr.txt.gz", case-insensitive but some
    // prefix segment is required; confirmed empirically, see
    // subworkflows/local/genotype_batch's own top-of-file note) and a
    // bare "${meta.id}.txt.gz" (meta.id here is just the contig name,
    // e.g. "chr1") wouldn't have the right suffix at all.
    withName: 'GATK_PRINT_SV_EVIDENCE_CONTIG_RD' {
        ext.prefix = { "${meta.id}.rd" }
        // No memory default existed here either (same fallback logic as
        // the cohort-wide GATK_PRINT_SV_EVIDENCE above -- see
        // modules/local/gatk4/print_sv_evidence_contig/main.nf's own
        // avail_mem block), but this call site is genuinely different in
        // kind: one contig's worth of one sample's evidence per task, not
        // a cohort-wide merge across every sample's tabix index at once
        // -- so its real memory need is small and doesn't scale with
        // cohort size the way the cohort-wide module's did. The 3GB
        // fallback was never wrong here, just silently defaulted every
        // single invocation (log.info's own "Available memory not known
        // - defaulting to 3GB" line, once per contig per sample --
        // genotype_batch.nf runs this per-contig, so a real run logs many
        // of these). Set explicitly to stop the noise, not because
        // anything OOM'd.
        memory = 4.GB
    }

    withName: 'GATK_PRINT_SV_EVIDENCE_CONTIG_PE' {
        ext.prefix = { "${meta.id}.pe" }
        memory = 4.GB
    }

    withName: 'GATK_PRINT_SV_EVIDENCE_CONTIG_SR' {
        ext.prefix = { "${meta.id}.sr" }
        memory = 4.GB
    }
}
