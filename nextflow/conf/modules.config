// Per-module publishDir/args overrides, keyed by process name (nf-core convention).

process {
    withName: 'MANTA_GERMLINE' {
        publishDir = [
            path: { "${params.outdir}/manta/${meta.id}" },
            mode: 'copy'
        ]
    }

    withName: 'WHAMG' {
        // GATK-SV's Wham task restricts calling to primary_contigs_list
        // via `-c` (wdl/Whamg.wdl:153). params.primary_contigs_list is a
        // static, sample-independent resource (one fixed file, not a
        // per-sample channel input), so its contents are read once here at
        // config-evaluation time rather than threaded through as a process
        // input.
        //
        // Must use the fully-qualified nextflow.Nextflow.file(), not the
        // bare file() factory function: ext.args closures run in a context
        // where `file` resolves to nextflow.script.ScriptBinding.file() (a
        // zero-arg accessor) instead, so a bare file(path) call fails with
        // "No signature of method: ...file() is applicable for argument
        // types: () values: []" -- a namespace collision specific to
        // config-closure scope, not present in ordinary workflow script
        // code. (A lib/*.groovy helper was tried first but classes there
        // aren't visible from conf/-included config closures in this
        // Nextflow version -- "No such variable" -- so the logic is
        // inlined here instead.)
        ext.args = {
            def contigs = params.primary_contigs_list
                ? nextflow.Nextflow.file(params.primary_contigs_list).readLines().findAll { it }.join(',')
                : ''
            contigs ? "-c ${contigs}" : ''
        }
        // Not published -- WHAM_FIX_SAMPLE_ID's output below is the one
        // downstream harmonisation should consume (correct sample ID/TAGS).
        // This process's own output has the BAM's SM tag, not sample_id.
    }

    withName: 'WHAM_FIX_SAMPLE_ID' {
        publishDir = [
            path: { "${params.outdir}/wham/${meta.id}" },
            mode: 'copy'
        ]
    }

    // GATK4_SVCLUSTER's own output is not published -- it's GATK-format,
    // pre-interval-exclusion, and gets refined further by
    // EXCLUDE_VARIANTS_BY_ID_POST + FORMAT_GATK_VCF_FOR_SVTK below.
    // Same pattern as WHAMG/WHAM_FIX_SAMPLE_ID above: only the final,
    // fully-processed output is published.

    withName: 'FORMAT_GATK_VCF_FOR_SVTK' {
        publishDir = [
            path: { "${params.outdir}/cluster/${meta.id}" },
            mode: 'copy'
        ]
    }
}
