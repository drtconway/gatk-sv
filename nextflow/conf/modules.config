// Per-module publishDir/args/resource overrides, keyed by process name
// (nf-core convention). Real-run failure history behind the resource values
// is in README.md's Status section.
//
// Escalating resources use `base * 2 ** (task.attempt - 1)`. Exit codes:
// 137 = SIGKILL (Slurm OOM kill), 140 = Slurm time limit, 1 = JVM
// OutOfMemoryError (which can also surface as 137).
//
// Only final outputs are published (SVTK_STANDARDIZE,
// FORMAT_GATK_VCF_FOR_SVTK, BCFTOOLS_FILL_TAGS_*); WHAMG/GATK4_SVCLUSTER*
// etc. are intermediates.

process {

    withName: 'WHAMG' {
        // Restrict calling to primary contigs (-c), as GATK-SV does
        // (wdl/Whamg.wdl:153). Must use nextflow.Nextflow.file(): a bare
        // file() inside a config closure resolves to a zero-arg
        // ScriptBinding accessor and fails.
        ext.args = {
            def contigs = params.primary_contigs_list
                ? nextflow.Nextflow.file(params.primary_contigs_list).readLines().findAll { it }.join(',')
                : ''
            contigs ? "-c ${contigs}" : ''
        }

        // Memory varies widely per sample: -c doesn't limit what whamg
        // loads, so reads on decoy/alt contigs still cost memory. 64GB
        // first attempt: some samples needed it, and a success on retry
        // can be invisible to -resume (README: "Tasks that only succeed on
        // retry"). Not part of the error_retry label because the vendored
        // module doesn't declare it.
        memory = { 64.GB * task.attempt }
        cpus   = 6
        time   = { 8.h * (2 ** (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries = 2
    }

    withName: 'MANTA_GERMLINE' {
        // Retry mechanics come from the error_retry label (nextflow.config).
        // Most samples take ~8-16h, but some need ~30h. The first attempt
        // matches the largest that has succeeded (48h/32GB), since a
        // success on retry can be invisible to -resume (README: "Tasks
        // that only succeed on retry"). 8 CPUs matches GATK-SV
        // (wdl/Manta.wdl:79). Changing time/memory doesn't invalidate
        // -resume.
        cpus   = 8
        time   = { 48.h * task.attempt }
        memory = { 32.GB * task.attempt }
        maxRetries = 2
    }

    withName: 'MEDIAN_COVERAGE' {
        memory = 96.GB
    }

    withName: 'GATK_COLLECT_READ_COUNTS' {
        // GATK-SV's real effective default (wdl/CollectCoverage.wdl: the
        // 12.0 fallback, not the unused default_attr.mem_gb 3.0).
        memory = 12.GB
    }

    withName: 'GATK_COLLECT_SV_EVIDENCE' {
        memory = 8.GB
    }

    // Cohort-wide merges: both open every sample's tabix index up front, so
    // memory scales with cohort size. Revisit as panels grow.
    withName: 'GATK_PRINT_SV_EVIDENCE' {
        memory = 32.GB
    }

    withName: 'GATK_SITE_DEPTH_TO_BAF' {
        memory = 32.GB
    }

    withName: 'GATK_AGGREGATESVEVIDENCE' {
        // Prefetches every sample's PE/SR/BAF evidence over each record's
        // interval: scales with cohort size x SV span, so one shard can
        // OOM while its siblings pass.
        memory        = { 16.GB * (2 ** (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [1, 137] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

    withName: 'SVTK_STANDARDIZE' {
        // Runs per caller per sample; outputs don't collide because the
        // filename includes the caller (*.<source>.std.vcf.gz).
        publishDir = [
            path: { "${params.outdir}/standardized/${meta.id}" },
            mode: 'copy'
        ]
    }

    withName: 'GATK4_SVCLUSTER.*' {
        // Regex: also covers the _JOIN/_SITES aliases (their blocks below
        // only add ext.args; Nextflow merges both). Genotype filling for
        // every sample on every record scales with cohort size x local
        // call density.
        memory        = { 32.GB * (2 ** (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [1, 137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

    withName: 'VCF_ENDS_BED_.*' {
        // Pad breakpoints by AggregateSVEvidence's PE outer window (500bp)
        // before the exclude-list endpoint check. Unpadded (GATK-SV's
        // behaviour), variants starting a few bp outside an excluded
        // artifact pileup survive, and their PE query then loads it in full
        // (91M+ lines in 1kb at chr2:32.916M), OOMing at any memory.
        ext.padding = 500
    }

    withName: 'FORMAT_GATK_VCF_FOR_SVTK' {
        // Used by stage 1 (meta.id = caller) and stage 2 (meta.id =
        // cohort_name), so publish paths don't collide.
        publishDir = [
            path: { "${params.outdir}/cluster/${meta.id}" },
            mode: 'copy'
        ]
    }

    withName: 'PLOIDY_TABLE_FROM_PED.*' {
        // Hash the inputs by content: the PED input is PED_SEXES' output,
        // which only changes when someone's sex does, so pedigree-only PED
        // edits leave the ploidy tables (same work dir, same output path)
        // and everything downstream cached.
        cache = 'deep'
    }

    withName: 'PLOIDY_TABLE_FROM_PED_COMBINE_BATCHES' {
        // CombineBatches keeps female chrY (wdl/CombineBatches.wdl:112);
        // stage 1's ploidy table doesn't.
        ext.retain_female_chr_y = true
    }

    withName: 'GATK4_SVCLUSTER_JOIN' {
        // CombineBatches' JoinVcfs: only merges exact duplicates across
        // callers; real clustering is the next step.
        ext.args = [
            '--fast-mode false',
            '--pesr-sample-overlap 0', '--pesr-interval-overlap 1', '--pesr-breakend-window 0',
            '--depth-sample-overlap 0', '--depth-interval-overlap 1', '--depth-breakend-window 0',
            '--mixed-sample-overlap 0', '--mixed-interval-overlap 1', '--mixed-breakend-window 0'
        ].join(' ')
    }

    withName: 'GATK4_SVCLUSTER_SITES' {
        // CombineBatches' ClusterSites; variant IDs prefixed with
        // cohort_name (meta.cohort).
        ext.args = { [
            '--fast-mode false', '--breakpoint-summary-strategy REPRESENTATIVE',
            "--variant-prefix ${meta.cohort}_",
            '--pesr-sample-overlap 0.5', '--pesr-interval-overlap 0.1', '--pesr-breakend-window 300',
            '--depth-sample-overlap 0.5', '--depth-interval-overlap 0.5', '--depth-breakend-window 500000',
            '--mixed-sample-overlap 0.5', '--mixed-interval-overlap 0.5', '--mixed-breakend-window 1000000'
        ].join(' ') }
    }

    withName: 'GATK4_GROUPEDSVCLUSTER_PART.*' {
        // The stratify values are the WDL task's defaults
        // (wdl/CombineBatches.wdl, GroupedSVClusterTask). Memory: same
        // genotype-filling cost as GATK4_SVCLUSTER.*, and sized for the
        // first attempt to succeed (README: "Tasks that only succeed on
        // retry").
        ext.args = [
            '--breakpoint-summary-strategy REPRESENTATIVE',
            '--stratify-overlap-fraction 0',
            '--stratify-num-breakpoint-overlaps 1',
            '--stratify-num-breakpoint-overlaps-interchromosomal 1'
        ].join(' ')
        memory        = { 32.GB * (2 ** (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [1, 137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

    withName: 'FORMAT_GATK_VCF_FOR_SVTK_COMBINE_BATCHES' {
        // CombineBatches' GatkToSvtkVcf. AC/AF are dropped because they
        // can't be lists here; BCFTOOLS_FILL_TAGS_COMBINED re-adds them.
        ext.args = [
            '--remove-formats CN,RD_MCR',
            '--remove-infos AC,AF,AN,HIGH_SR_BACKGROUND,BOTHSIDES_SUPPORT,SR1POS,SR2POS',
            '--set-pass'
        ].join(' ')
    }

    // Concat modes, matching GATK-SV: --allow-overlaps where inputs come
    // from different callers; --naive where shards are already sorted and
    // non-overlapping by construction.
    withName: 'CONCAT_INPUT_VCFS' {
        ext.args = '--allow-overlaps'
    }

    withName: 'CONCAT_OUTPUT_VCFS' {
        ext.args = '--naive'
    }

    withName: 'MERGE_PESR_DEPTH_VCFS' {
        ext.args = '--allow-overlaps'
    }

    withName: 'CONCAT_GENOTYPE_BATCH_SHARDS' {
        ext.args = '--naive'
    }

    withName: 'BCFTOOLS_FILL_TAGS_(DEPTH|PESR)' {
        // genotype_batch's final VCFs, with AN/AC/AF added.
        publishDir = [
            path: { "${params.outdir}/genotype_batch" },
            mode: 'copy'
        ]
    }

    // ResolveComplexVariants: per-pass shard merge and the genome-wide
    // merge of contigs (upstream: ConcatVcfs / ReshardVcf, both
    // --allow-overlaps).
    withName: 'CONCAT_RESOLVED_SHARDS' {
        ext.args = '--allow-overlaps'
    }

    withName: 'CONCAT_COMPLEX_RESOLVE' {
        ext.args = '--allow-overlaps'
        publishDir = [
            path: { "${params.outdir}/resolve_complex" },
            mode: 'copy'
        ]
    }

    withName: 'CONCAT_COMPLEX_GENOTYPE' {
        // GenotypeComplexVariants' genome-wide merge of contigs.
        ext.args = '--allow-overlaps'
        publishDir = [
            path: { "${params.outdir}/genotype_complex" },
            mode: 'copy'
        ]
    }

    withName: 'CONCAT_CLEANED_VCFS' {
        // CleanVcf's genome-wide merge of contigs.
        ext.args = '--allow-overlaps'
    }

    withName: 'COMPUTE_AFS_CLEANED' {
        // The cleaned cohort VCF (MakeCohortVcf's output), with sex-aware AN/AC/AF.
        publishDir = [
            path: { "${params.outdir}/clean_vcf" },
            mode: 'copy'
        ]
    }

    withName: 'BCFTOOLS_FILL_TAGS_COMBINED' {
        // CombineBatches' cohort VCF, with AN/AC/AF added.
        publishDir = [
            path: { "${params.outdir}/combine_batches" },
            mode: 'copy'
        ]
    }

    // Per-contig PrintSVEvidence (genotype_batch). GATK picks the codec
    // from the filename suffix (.rd/.pe/.sr.txt.gz), so the prefix must
    // carry it; meta.id is just the contig name. Small per-task memory.
    withName: 'GATK_PRINT_SV_EVIDENCE_CONTIG_RD' {
        ext.prefix = { "${meta.id}.rd" }
        memory = 4.GB
    }

    withName: 'GATK_PRINT_SV_EVIDENCE_CONTIG_PE' {
        ext.prefix = { "${meta.id}.pe" }
        memory = 4.GB
    }

    withName: 'GATK_PRINT_SV_EVIDENCE_CONTIG_SR' {
        ext.prefix = { "${meta.id}.sr" }
        memory = 4.GB
    }
}
