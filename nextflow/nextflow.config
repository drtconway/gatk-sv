params {
    // Sample sheet: TSV with family_id, sample_id, bam, bai (see README.md#sample-sheet)
    input = null

    // Reference genome (hg38), required by all callers
    fasta         = null
    fasta_fai     = null
    reference_dict = null  // .dict sequence dictionary, required by GATK4_SVCLUSTER

    // Static, sample-independent resources -- one fixed file for the whole
    // reference, not per-sample. See README.md#panel-bundle-contents for
    // the broader static-vs-per-sample split this follows.
    primary_contigs_list = null  // list of canonical contigs, used e.g. by Wham (-c), and to filter every caller's output to primary contigs only
    ped                  = null  // pedigree file for the whole run (see README.md#pedigree-file)
    pesr_exclude_intervals     = null  // blacklist BED for PE/SR clustering (centromeres etc.)
    pesr_exclude_intervals_tbi = null
    manta_region_bed     = null  // primary contigs + mito, restricts Manta's own calling (--callRegions)
    manta_region_bed_tbi = null

    outdir = './results'
}

plugins {
    id 'nf-schema@2.7.2'
}

validation {
    parametersSchema = 'nextflow_schema.json'
    monochromeLogs = false
}

profiles {
    docker {
        docker.enabled = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    stub {
        // For validating pipeline wiring without running real tools/data:
        // nextflow run workflows/call_manta.nf -profile stub -stub-run
    }
}

process {
    // Per nf-core convention, resource labels are defined here; per-module
    // overrides (container args, publishDir, resource tweaks) belong in
    // conf/modules.config, not here.
    withLabel: process_medium {
        cpus   = 6
        memory = 12.GB
        time   = 8.h
    }
}

includeConfig 'conf/modules.config'
