params {
    // Sample sheet: TSV with family_id, sample_id, bam, bai (see README.md#sample-sheet)
    input = null

    // Reference genome (hg38), required by all callers
    fasta         = null
    fasta_fai     = null
    reference_dict = null  // .dict sequence dictionary, required by GATK4_SVCLUSTER

    // Static, sample-independent resources -- one fixed file for the whole
    // reference, not per-sample. See README.md#panel-bundle-contents for
    // the broader static-vs-per-sample split this follows.
    primary_contigs_list = null  // plain list of canonical contigs, used by Wham (-c)
    primary_contigs_fai  = null  // .fai-format contig+length list, used by svtk standardize (--contigs)
    ped                  = null  // pedigree file for the whole run (see README.md#pedigree-file)
    pesr_exclude_intervals     = null  // blacklist BED for PE/SR clustering (centromeres etc.)
    pesr_exclude_intervals_tbi = null
    manta_region_bed     = null  // primary contigs + mito, restricts Manta's own calling (--callRegions)
    manta_region_bed_tbi = null
    min_svsize = 50  // minimum SV size to retain (GATK-SV default), applied by svtk standardize

    // Harmonisation stage 2 (cross-caller merge, vcfs_combine_batches):
    // GroupedSVCluster's clustering/stratification config and genomic
    // context tracks. All GATK-SV public-bucket resources.
    clustering_config_part1     = null
    stratification_config_part1 = null
    clustering_config_part2     = null
    stratification_config_part2 = null
    clustering_track_sr = null  // simple repeats
    clustering_track_sd = null  // segmental duplications
    clustering_track_rm = null  // RepeatMasker

    // Per-sample evidence collection (bam_collect_evidence): GATK's
    // CollectSVEvidence/CollectReadCounts walkers. Both GATK-SV
    // public-bucket resources, same pattern as everything else above.
    sd_locs_vcf     = null  // dbSNP sites, for CollectSVEvidence's site-depth/BAF collection (-F).
                             // Plain (uncompressed) VCF with a GATK .idx sibling index -- NOT
                             // bgzipped/.tbi like every other VCF in this pipeline.
    sd_locs_vcf_idx = null
    preprocessed_intervals = null  // fixed genome-wide bins, for CollectReadCounts (-L)

    outdir = './results'
}

plugins {
    id 'nf-schema@2.7.2'
}

validation {
    parametersSchema = 'nextflow_schema.json'
    monochromeLogs = false
}

profiles {
    docker {
        docker.enabled = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    stub {
        // For validating pipeline wiring without running real tools/data:
        // nextflow run workflows/call_manta.nf -profile stub -stub-run
    }
}

process {
    // Nextflow's own default task shell is ['/bin/bash', '-ue'] -- no
    // pipefail. Several modules (e.g. whamg, `cmd1 | bgzip > out.gz`)
    // pipe a tool's output through a second command; without pipefail,
    // bash's pipeline exit status is only the *last* command's, so a
    // SIGKILL'd (e.g. OOM-killed) first command is invisible to Nextflow
    // as long as the second command still exits 0 on the truncated
    // stream -- which bgzip does. This produced a real failure: a
    // Slurm-OOM-killed whamg process was reported as a *successful* task
    // by Nextflow, and the truncated/empty output only surfaced several
    // steps later as a confusing "invalid file, is it VCF/BCF format?"
    // error in an unrelated downstream process. Not specific to Slurm or
    // any executor -- the same silent failure would happen locally too;
    // it's a gap in the default shell options, not the HPC profile.
    shell = ['/bin/bash', '-ueo', 'pipefail']

    // Per nf-core convention, resource labels are defined here; per-module
    // overrides (container args, publishDir, resource tweaks) belong in
    // conf/modules.config, not here.
    withLabel: process_medium {
        cpus   = 6
        memory = 12.GB
        time   = 8.h
    }
}

includeConfig 'conf/modules.config'
